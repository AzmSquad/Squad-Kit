---
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Page not found · squad-kit">
  <section class="container-page flex min-h-[60vh] flex-col items-start justify-center py-24">
    <h1 class="text-5xl font-semibold tracking-tight">This page is not here.</h1>
    <p class="mt-4 max-w-xl text-lg text-[var(--color-text-muted)]">
      It may have moved when squad-kit 1.0 came out. Start from the home page, or open the docs.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Go to the home page</a>
      <a href="/docs/getting-started" class="btn-secondary">Open the docs</a>
    </div>
  </section>
</Layout>
