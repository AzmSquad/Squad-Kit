---
import Cmd from "./Cmd.astro";
import Film from "./Film.astro";
import { hasFilm } from "~/lib/film";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-page hero-text">
    <a class="news" href="https://github.com/AzmSquad/Squad-Kit/releases/tag/v1.0.0" target="_blank" rel="noopener">
      <span class="dot" aria-hidden="true"></span><span>squad-kit 1.0 is out<span class="more">: one app for all your projects</span></span>
    </a>
    <h1 id="hero-title">Your Engineering Squad.<br />One Powerful AI Harness.</h1>
    <p class="lead">
      Your AI Engineering Squad transforms ideas into production-ready software. Powered by a unified agentic
      harness, specialized AI agents collaborate across analysis, architecture, development, testing, and review,
      following engineering best practices, while you lead the decisions that matter.
    </p>
    <div class="actions">
      <a href="#start" class="btn-primary">Get started</a>
      <Cmd text="npm i -g squad-kit" class="install" />
    </div>
  </div>

  {hasFilm && <Film />}
</section>

<style>
  .hero {
    padding-top: clamp(32px, 4.5vw, 60px);
    padding-bottom: 24px;
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .news {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    border-radius: 99px;
    padding: 6px 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-accent-dim);
  }
  .news:hover { border-color: var(--color-accent); }
  @media (max-width: 520px) {
    .news { font-size: 13px; padding: 5px 12px; }
    .news .more { display: none; }
  }
  .news .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 0 3px var(--color-accent-glow); }
  h1 {
    margin-top: 24px;
    font-size: clamp(38px, 6.2vw, 88px);
    line-height: 0.96;
    font-weight: 650;
    font-stretch: 84%;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .lead {
    margin-top: 22px;
    max-width: 64ch;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.55;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

</style>
