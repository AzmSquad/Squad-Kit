---
import { filmPoster, filmYouTubeId } from "~/lib/film";

/** The film: real footage of squad-kit taking a ticket from idea to release. Nothing loads from YouTube until play. */
const watch = `https://www.youtube.com/watch?v=${filmYouTubeId}`;
---

<section id="film" class="film" aria-labelledby="film-title">
  <div class="container-page">
    <h2 id="film-title">Watch a ticket go from idea to release</h2>
    <p>A real run, recorded start to finish: the questions, the spec, the build, an Arabic talk, the proof and the release. Two and a half minutes.</p>
    <div class="player" data-film={filmYouTubeId}>
      <img src={filmPoster} alt="The squad-kit 1.0 film: from idea to release in 7 minutes, for $1.53." width="1920" height="1080" loading="lazy" decoding="async" />
      <button type="button" class="play" data-play aria-label="Play the film">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
        <span>Play the film</span>
      </button>
    </div>
    <p class="alt"><a href={watch} target="_blank" rel="noopener">Watch it on YouTube</a></p>
  </div>
</section>

<script>
  for (const box of document.querySelectorAll<HTMLElement>("[data-film]")) {
    box.querySelector("[data-play]")?.addEventListener("click", () => {
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${box.dataset.film}?autoplay=1&rel=0`;
      frame.title = "squad-kit 1.0 film";
      frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      frame.allowFullscreen = true;
      box.replaceChildren(frame);
      frame.focus();
    });
  }
</script>

<style>
  .film { padding: clamp(72px, 9vw, 120px) 0; background: var(--color-night); color: var(--color-night-text); }
  h2 { font-size: clamp(34px, 4.6vw, 58px); line-height: 1.02; font-weight: 650; font-stretch: 86%; letter-spacing: -0.03em; text-wrap: balance; max-width: 18ch; }
  p { margin-top: 16px; font-size: 18px; line-height: 1.6; color: var(--color-night-muted); max-width: 60ch; }
  .player {
    position: relative; margin-top: 40px; aspect-ratio: 16 / 9; width: 100%;
    border-radius: 16px; overflow: hidden; border: 1px solid var(--color-night-line); background: #000;
  }
  .player img, .player :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; }
  .play {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: inline-flex; align-items: center; gap: 12px;
    padding: 16px 26px 16px 20px; border-radius: 99px;
    background: var(--color-text); color: #fff; font-size: 18px; font-weight: 650;
    box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.7);
    transition: transform 0.15s, background 0.15s;
  }
  .play:hover { background: var(--color-accent); transform: translate(-50%, -50%) scale(1.04); }
  .play svg { color: #7cd99b; }
  .play:hover svg { color: #fff; }
  .alt { margin-top: 14px; font-size: 15px; }
  .alt a { color: #7cd99b; text-decoration: underline; text-underline-offset: 4px; }
</style>
