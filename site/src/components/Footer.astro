---
const year = new Date().getFullYear();
const links = [
  { href: "/docs/getting-started", label: "Getting started" },
  { href: "/docs/migrating-to-1.0", label: "Moving to 1.0" },
  { href: "/docs/console", label: "The app" },
  { href: "https://www.npmjs.com/package/squad-kit", label: "npm", external: true },
  { href: "https://github.com/AzmSquad/Squad-Kit", label: "GitHub", external: true },
  { href: "https://github.com/AzmSquad/Squad-Kit/releases", label: "Releases", external: true },
  { href: "https://github.com/AzmSquad/Squad-Kit/issues", label: "Report a problem", external: true },
  { href: "/privacy", label: "Privacy" },
];
---

<footer class="border-t border-[var(--color-border)] py-12">
  <div class="container-page flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex items-start gap-3">
      <img src="/logo.svg" alt="" width="32" height="32" class="h-8 w-8" />
      <div>
        <div class="font-semibold">squad-kit</div>
        <p class="mt-1 max-w-xs text-sm text-[var(--color-text-muted)]">Your AI Engineering Squad. One Unified Harness.</p>
        <p class="mt-3 text-xs text-[var(--color-text-dim)]">Free and open source, MIT license. © {year} Momen Yasser</p>
      </div>
    </div>

    <ul class="grid grid-cols-2 gap-x-10 gap-y-2.5 text-sm sm:grid-cols-3">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
            {...(l.external ? { target: "_blank", rel: "noopener" } : {})}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
